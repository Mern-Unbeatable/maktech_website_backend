generator client {
  output = "../../src/generated/prisma"
  provider = "prisma-client-js"
  
}

datasource db {
  provider = "postgresql"
}

// ==========================================
// 1. USERS & ROLES
// ==========================================
model User {
  id        String   @id @default(cuid())
  name      String?
  email     String   @unique
  password  String
  role      Role     @default(ADMIN)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  posts     Post[]
}

enum Role {
  ADMIN
  CUSTOMER
  EDITOR
}

// ==========================================
// 2. EMAILS (Helpdesk / CRM System)
// ==========================================
model EmailThread {
  id          String   @id @default(cuid())
  subject     String
  clientEmail String
  clientName  String?
  status      EmailStatus @default(UNREAD)
  
  messages    EmailMessage[]
  
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model EmailMessage {
  id          String   @id @default(cuid())
  
  // Links to the main conversation thread
  threadId    String
  thread      EmailThread @relation(fields: [threadId], references: [id], onDelete: Cascade)
  
  // Was this received from the client, or sent by the admin?
  direction   EmailDirection 
  
  fromEmail   String
  toEmail     String
  
  // Stored as JSON to handle complex HTML structures or attachments easily
  body        Json?
  
  sentAt      DateTime @default(now())
}

enum EmailStatus {
  UNREAD
  READ
  REPLIED
}

enum EmailDirection {
  INBOUND  // Incoming from client
  OUTBOUND // Outgoing from Admin
}


// ==========================================
// 3. LEADS (Contact Form Submissions)
// ==========================================
model Lead {
  id          String   @id @default(cuid())
  fullName    String
  companyName String?
  email       String
  phone       String?
  location    String?
  service     String?
  budget      Float?
  industry    String?
  message     String?  @db.Text
  status      LeadStatus @default(NEW)
  source      LeadSource @default(WEBSITE)
  
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

enum LeadSource {
  WEBSITE
  MANUAL
}

enum LeadStatus {
  NEW
  CONTACTED
  IN_PROGRESS
  CONVERTED
  LOST
}

// ==========================================
// 4. ORDERS
// ==========================================
model Order {
  id          String   @id @default(cuid())
  orderNumber String   @unique
  clientName  String
  clientEmail String
  amount      Float
  status      OrderStatus @default(PENDING)
  
  // Optional relation to PricingPlan if order is tied to a plan
  planId      String?
  plan        PricingPlan? @relation(fields: [planId], references: [id])

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

enum OrderStatus {
  PENDING
  PROCESSING
  COMPLETED
  CANCELLED
}

// ==========================================
// 5. CASE STUDIES (Portfolio)
// ==========================================
model CaseStudy {
  id          String   @id @default(cuid())
  title       String
  slug        String   @unique
  clientName  String
  coverImage  String?
  
  // Using JSON for flexible sections (overview, challenges, solutions, etc.)
  content     Json?
  
  isPublished Boolean  @default(false)
  
  services    CaseStudyService[] // Bridge relation

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Service {
  id          String   @id @default(cuid())
  name        String   @unique
  slug        String   @unique
  
  caseStudies CaseStudyService[] // Bridge relation
}

// Explicit Bridge Table: CaseStudy <-> Service
model CaseStudyService {
  caseStudyId String
  serviceId   String
  
  caseStudy   CaseStudy @relation(fields: [caseStudyId], references: [id], onDelete: Cascade)
  service     Service   @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  @@id([caseStudyId, serviceId])
}

// ==========================================
// 6. BLOG
// ==========================================
model Post {
  id          String   @id @default(cuid())
  title       String
  slug        String   @unique
  excerpt     String?  @db.Text
  
  // Using JSON for Rich Text Editor block data
  content     Json?
  
  coverImage  String?
  isPublished Boolean  @default(false)
  
  authorId    String
  author      User     @relation(fields: [authorId], references: [id])
  
  tags        PostTag[] // Bridge relation
  
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Tag {
  id    String   @id @default(cuid())
  name  String   @unique
  slug  String   @unique
  
  posts PostTag[] // Bridge relation
}

// Explicit Bridge Table: Post <-> Tag
model PostTag {
  postId String
  tagId  String
  
  post   Post @relation(fields: [postId], references: [id], onDelete: Cascade)
  tag    Tag  @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([postId, tagId])
}

// ==========================================
// 7. JOBS & APPLICATIONS
// ==========================================
model Job {
  id               String   @id @default(cuid())
  title            String
  description      String   @db.Text
  department       String
  vacancy          Int      @default(1)
  salary           String?
  coverImage       String?
  isActive         Boolean  @default(true)
  
  // JSON arrays mapping exactly to React state: [{ title: "", description: "", icon?: "" }]
  jobTypes         Json?
  responsibilities Json?
  benefits         Json?
  
  // Kept questions relational because applications must reference them
  questions        JobQuestion[]
  applications     JobApplication[]
  
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}

// Relational questions so JobApplicationAnswer can link exactly to a question ID
model JobQuestion {
  id          String  @id @default(cuid())
  title       String
  type        String  // e.g. short_answer, multiple_choice, checkboxes
  isRequired  Boolean @default(false)
  order       Int     @default(0)
  
  jobId       String
  job         Job     @relation(fields: [jobId], references: [id], onDelete: Cascade)
  
  options     JobQuestionOption[]
  answers     JobApplicationAnswer[]
}

model JobQuestionOption {
  id          String  @id @default(cuid())
  value       String
  order       Int     @default(0)
  
  questionId  String
  question    JobQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)
}

// When a candidate applies from the frontend
model JobApplication {
  id            String   @id @default(cuid())
  applicantName String
  applicantEmail String
  resumeUrl     String?
  status        ApplicationStatus @default(PENDING)
  
  jobId         String
  job           Job      @relation(fields: [jobId], references: [id], onDelete: Cascade)
  
  answers       JobApplicationAnswer[]
  
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

enum ApplicationStatus {
  PENDING
  REVIEWING
  INTERVIEW
  REJECTED
  HIRED
}

model JobApplicationAnswer {
  id            String  @id @default(cuid())
  
  // JSON so we can store array of selected checkbox values OR a plain string
  answerData    Json
  
  applicationId String
  application   JobApplication @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  
  questionId    String
  question      JobQuestion    @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@unique([applicationId, questionId])
}

// ==========================================
// 8. PRICING
// ==========================================
model PricingPlan {
  id           String   @id @default(cuid())
  name         String
  description  String?
  price        Float
  billingCycle BillingCycle @default(MONTHLY)
  isPopular    Boolean  @default(false)
  
  features     PlanFeature[]
  orders       Order[]
  
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

enum BillingCycle {
  MONTHLY
  YEARLY
  ONETIME
}

model PlanFeature {
  id         String   @id @default(cuid())
  name       String
  isIncluded Boolean  @default(true)
  order      Int      @default(0)
  
  planId     String
  plan       PricingPlan @relation(fields: [planId], references: [id], onDelete: Cascade)
}


